using System;
class RecorrerMat
{
    static void Main()
    {
        int[,] numeros = new int[2,2];
        numeros[0,0] = 10;
        numeros[0,1] = 20;
        numeros[1,0] = 30;
        numeros[1,1] = 40;
        //recorremos la matriz por columnas
        for (int i = 0; i < 2; i++)
        {
            for (int j = 0; j < 2; j++)
            {
                Console.WriteLine(numeros[j][i]);
            }
        }
    }
}
