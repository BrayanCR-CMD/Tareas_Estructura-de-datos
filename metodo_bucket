//metodo de ordenamiento bucket sort
using System;
using System.Collections.Generic;
class BucketSort
{
    public static void Sort(float[] array)
    {
        int n = array.Length;
        if (n <= 0)
            return;

        // Crear n cubetas
        List<float>[] buckets = new List<float>[n];
        for (int i = 0; i < n; i++)
        {
            buckets[i] = new List<float>();
        }

        // Distribuir los elementos en las cubetas
        for (int i = 0; i < n; i++)
        {
            int bucketIndex = (int)(array[i] * n);
            if (bucketIndex >= n) bucketIndex = n - 1; // Manejar el caso del valor máximo
            buckets[bucketIndex].Add(array[i]);
        }

        // Ordenar cada cubeta y concatenar los resultados
        int index = 0;
        for (int i = 0; i < n; i++)
        {
            buckets[i].Sort();
            foreach (float value in buckets[i])
            {
                array[index++] = value;
            }
        }
    }

    static void Main(string[] args)
    {
        float[] array = { 0.42f, 0.32f, 0.23f, 0.52f, 0.25f, 0.47f, 0.51f };
        Console.WriteLine("Array original: " + string.Join(", ", array));
        
        Sort(array);
        
        Console.WriteLine("Array ordenado: " + string.Join(", ", array));
    }
}