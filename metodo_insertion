using System;
class ord_insertion
{
    static void Main()
    {
        int[] numeros = new int[10];
        int opcion;
        for (int i = 0; i < numeros.Length; i++)
        {
            Console.WriteLine("ingresa un numero:");
            numeros[i] = int.Parse(Console.ReadLine());
            Console.Clear();
        }
        
        Console.WriteLine("desea ordenar los numeros? \n1:si 2:no");
        opcion = int.Parse(Console.ReadLine());
        Console.Clear();

        if (opcion == 1)
        {
            Console.WriteLine("los numeros sin ordenar son:");
            for (int i = 0; i < numeros.Length; i++)
            {
                Console.WriteLine(numeros[i]);
            }
            ordenar(numeros);
            Console.WriteLine("los numeros ordenados son:");
            for (int i = 0; i < numeros.Length; i++)
            {
                Console.WriteLine(numeros[i]);
            }
        }

    }
    static void ordenar(int[] numeros)
    {
        int aux, j;
        for (int i = 1; i < numeros.Length; i++)
        {
            aux = numeros[i];
            j = i - 1;
            while (j >= 0 && numeros[j] > aux)
            {
                numeros[j + 1] = numeros[j];
                j--;
            }
            numeros[j + 1] = aux;
        }
    }
}
